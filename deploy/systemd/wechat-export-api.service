[Unit]
Description=WeChat Vault Muse Export API
After=network.target

[Service]
Type=simple
User=__WXUSER__
Group=__WXUSER__
WorkingDirectory=__WXHOME__/.local/share/wechat-vault
ExecStart=/usr/bin/python3 __WXHOME__/.local/share/wechat-vault/bin/wechat_export_api.py --config __WXHOME__/.local/share/wechat-vault/config/export_service.json
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
