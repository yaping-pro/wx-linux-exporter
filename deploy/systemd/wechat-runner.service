[Unit]
Description=WeChat Linux Native Client Daemon
After=wechat-xvfb.service
Wants=wechat-xvfb.service

[Service]
Type=simple
User=__WXUSER__
Environment=DISPLAY=:99
Environment=XDG_CURRENT_DESKTOP=GNOME
Environment=QT_QPA_PLATFORM=xcb
ExecStart=/opt/wechat/wechat
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
